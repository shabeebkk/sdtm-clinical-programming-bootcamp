     "core": "Req",
     "origin": "Assigned",
     "srcData": "",
     "srcVar": "",
     "rule": "Literal \"AE\" \u2014 the domain this qualifies",
     "ct": "",
     "notes": ""
    },
    {
     "name": "USUBJID",
     "label": "Unique Subject Identifier",
     "type": "Char",
     "core": "Req",
     "origin": "Derived",
     "srcData": "sdtm/ae.csv",
     "srcVar": "USUBJID",
     "rule": "Copied from the parent AE record",
     "ct": "",
     "notes": ""
    },
    {
     "name": "IDVAR",
     "label": "Identifying Variable",
     "type": "Char",
     "core": "Exp",
     "origin": "Assigned",
     "srcData": "",
     "srcVar": "",
     "rule": "Literal \"AESEQ\" \u2014 how we point at the parent row",
     "ct": "",
     "notes": ""
    },
    {
     "name": "IDVARVAL",
     "label": "Identifying Variable Value",
     "type": "Char",
     "core": "Exp",
     "origin": "Derived",
     "srcData": "sdtm/ae.csv",
     "srcVar": "AESEQ",
     "rule": "The parent record's AESEQ value",
     "ct": "",
     "notes": ""
    },
    {
     "name": "QNAM",
     "label": "Qualifier Variable Name",
     "type": "Char",
     "core": "Req",
     "origin": "Assigned",
     "srcData": "",
