     "core": "Req",
     "origin": "Derived",
     "srcData": "sdtm/ae.csv",
     "srcVar": "AESTDY",
     "rule": "Y if AESTDY >= 1 (on/after first dose), else N",
     "ct": "NY",
     "notes": "All Y in ABC-01 \u2014 see the spec caveat"
    },
    {
     "name": "QORIG",
     "label": "Origin",
     "type": "Char",
     "core": "Exp",
     "origin": "Assigned",
     "srcData": "",
     "srcVar": "",
     "rule": "Literal \"DERIVED\"",
     "ct": "",
     "notes": ""
    },
    {
     "name": "QEVAL",
     "label": "Evaluator",
     "type": "Char",
     "core": "Perm",
     "origin": "Assigned",
     "srcData": "",
     "srcVar": "",
     "rule": "Blank \u2014 derived, not assessed by a person",
     "ct": "",
     "notes": ""
    }
   ],
   "example": {
