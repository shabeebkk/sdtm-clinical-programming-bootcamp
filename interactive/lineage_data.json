{
 "study": "ABC-01",
 "domains": [
  {
   "name": "DM",
   "class": "Special Purpose",
   "structure": "One record per subject",
   "variables": [
    {
     "name": "STUDYID",
     "label": "Study Identifier",
     "type": "Char",
     "core": "Req",
     "origin": "Assigned",
     "srcData": "dm_raw",
     "srcVar": "STUDYID",
     "rule": "Constant \"ABC-01\"",
     "ct": "",
     "notes": ""
    },
    {
     "name": "DOMAIN",
     "label": "Domain Abbreviation",
     "type": "Char",
     "core": "Req",
     "origin": "Assigned",
     "srcData": "",
     "srcVar": "",
     "rule": "Literal \"DM\"",
     "ct": "",
     "notes": ""
    },
    {
     "name": "USUBJID",
     "label": "Unique Subject Identifier",
     "type": "Char",
     "core": "Req",
     "origin": "Derived",
     "srcData": "dm_raw",
     "srcVar": "SITEID, SUBJID",
     "rule": "STUDYID || \"-\" || SITEID || \"-\" || SUBJID",
     "ct": "",
     "notes": "Keep IDs as character"
    },
    {
     "name": "SUBJID",
     "label": "Subject Identifier for the Study",
     "type": "Char",
     "core": "Req",
     "origin": "Collected",
     "srcData": "dm_raw",
     "srcVar": "SUBJID",
     "rule": "As collected (site-local id)",
     "ct": "",
     "notes": "Not unique across sites"
    },
    {
     "name": "RFSTDTC",
     "label": "Subject Reference Start Date/Time",
     "type": "Char",
     "core": "Exp",
     "origin": "Derived",
     "srcData": "ex_raw",
     "srcVar": "EXSTDTC",
     "rule": "min(EXSTDTC) per subject = first dose date",
     "ct": "",
     "notes": "DEFINES STUDY DAY 1 for the whole study"
    },
    {
     "name": "RFENDTC",
     "label": "Subject Reference End Date/Time",
     "type": "Char",
     "core": "Exp",
     "origin": "Derived",
     "srcData": "ex_raw",
     "srcVar": "EXENDTC",
     "rule": "max(EXENDTC) per subject = last dose date",
     "ct": "",
     "notes": ""
    },
    {
     "name": "RFXSTDTC",
     "label": "Date/Time of First Study Treatment",
     "type": "Char",
     "core": "Exp",
     "origin": "Derived",
     "srcData": "ex_raw",
     "srcVar": "EXSTDTC",
     "rule": "Same as RFSTDTC",
     "ct": "",
     "notes": ""
    },
    {
     "name": "RFXENDTC",
     "label": "Date/Time of Last Study Treatment",
     "type": "Char",
     "core": "Exp",
     "origin": "Derived",
     "srcData": "ex_raw",
     "srcVar": "EXENDTC",
     "rule": "Same as RFENDTC",
     "ct": "",
     "notes": ""
    },
    {
     "name": "RFICDTC",
     "label": "Date/Time of Informed Consent",
     "type": "Char",
     "core": "Exp",
     "origin": "Collected",
     "srcData": "dm_raw",
     "srcVar": "RFICDTC",
     "rule": "Convert to ISO 8601",
     "ct": "",
     "notes": "Reference date for AGE; also a DS protocol milestone"
    },
    {
     "name": "RFPENDTC",
     "label": "Date/Time of End of Participation",
     "type": "Char",
     "core": "Exp",
     "origin": "Collected",
     "srcData": "ds_raw",
     "srcVar": "EOSDT",
     "rule": "Convert to ISO 8601",
     "ct": "",
     "notes": "From the DISPOSITION form \u2014 NOT demographics"
    },
    {
     "name": "DTHDTC",
     "label": "Date/Time of Death",
     "type": "Char",
     "core": "Exp",
     "origin": "Collected",
     "srcData": "",
     "srcVar": "",
     "rule": "Null \u2014 no deaths in this study",
     "ct": "",
     "notes": ""
    },
    {
     "name": "DTHFL",
     "label": "Subject Death Flag",
     "type": "Char",
     "core": "Exp",
     "origin": "Derived",
     "srcData": "",
     "srcVar": "",
     "rule": "Null \u2014 no deaths in this study",
     "ct": "NY",
     "notes": ""
    },
    {
     "name": "SITEID",
     "label": "Study Site Identifier",
     "type": "Char",
     "core": "Req",
     "origin": "Collected",
     "srcData": "dm_raw",
     "srcVar": "SITEID",
     "rule": "As collected",
     "ct": "",
     "notes": "Character \u2014 preserve leading zero"
    },
    {
     "name": "AGE",
     "label": "Age",
     "type": "Num",
     "core": "Exp",
     "origin": "Derived",
     "srcData": "dm_raw",
     "srcVar": "BRTHDTC, RFICDTC",
     "rule": "Completed years from BRTHDTC to RFICDTC",
     "ct": "",
     "notes": "Edge case: born 1969-05-14, consent 2024-02-20 -> 54 not 55"
    },
    {
     "name": "AGEU",
     "label": "Age Units",
     "type": "Char",
     "core": "Exp",
     "origin": "Assigned",
     "srcData": "",
     "srcVar": "",
     "rule": "Literal \"YEARS\"",
     "ct": "AGEU",
     "notes": ""
    },
    {
     "name": "SEX",
     "label": "Sex",
     "type": "Char",
     "core": "Req",
     "origin": "Collected",
     "srcData": "dm_raw",
     "srcVar": "SEX",
     "rule": "CT lookup: 1 -> M, 2 -> F",
     "ct": "SEX",
     "notes": "EDC stores a numeric code"
    },
    {
     "name": "RACE",
     "label": "Race",
     "type": "Char",
     "core": "Exp",
     "origin": "Collected",
     "srcData": "dm_raw",
     "srcVar": "RACE",
     "rule": "Trim + upper-case, then map to CT",
     "ct": "RACE",
     "notes": "Raw is mixed case with a trailing space"
    },
    {
     "name": "ETHNIC",
     "label": "Ethnicity",
     "type": "Char",
     "core": "Perm",
     "origin": "Collected",
     "srcData": "dm_raw",
     "srcVar": "ETHNIC",
     "rule": "Upper-case, then map to CT",
     "ct": "ETHNIC",
     "notes": ""
    },
    {
     "name": "ARMCD",
     "label": "Planned Arm Code",
     "type": "Char",
     "core": "Req",
     "origin": "Derived",
     "srcData": "dm_raw",
     "srcVar": "ARM",
     "rule": "Drug A -> A ; Placebo -> P",
     "ct": "",
     "notes": "Max 20 chars, no spaces"
    },
    {
     "name": "ARM",
     "label": "Description of Planned Arm",
     "type": "Char",
     "core": "Req",
     "origin": "Collected",
     "srcData": "dm_raw",
     "srcVar": "ARM",
     "rule": "As collected",
     "ct": "",
     "notes": ""
    },
    {
     "name": "ACTARMCD",
     "label": "Actual Arm Code",
     "type": "Char",
     "core": "Req",
     "origin": "Derived",
     "srcData": "dm_raw",
     "srcVar": "ARM",
     "rule": "Same as ARMCD",
     "ct": "",
     "notes": "As-treated = as-planned in this study"
    },
    {
     "name": "ACTARM",
     "label": "Description of Actual Arm",
     "type": "Char",
     "core": "Req",
     "origin": "Derived",
     "srcData": "dm_raw",
     "srcVar": "ARM",
     "rule": "Same as ARM",
     "ct": "",
     "notes": "Would differ if a subject were mis-dosed"
    },
    {
     "name": "COUNTRY",
     "label": "Country",
     "type": "Char",
     "core": "Req",
     "origin": "Collected",
     "srcData": "dm_raw",
     "srcVar": "COUNTRY",
     "rule": "As collected",
     "ct": "COUNTRY",
     "notes": "Already ISO 3166-1 alpha-3"
    }
   ],
   "example": {
    "usubjid": "ABC-01-01-002",
    "raw": {
     "STUDYID": "ABC-01",
     "SITEID": "01",
     "SUBJID": "002",
     "BRTHDTC": "02-NOV-1963",
     "SEX": "1",
     "RACE": "Asian",
     "ETHNIC": "Not Hispanic or Latino",
     "COUNTRY": "JPN",
     "ARM": "Placebo",
     "RFICDTC": "22-FEB-2024",
     "RANDDTC": "04-MAR-2024"
    },
    "sdtm": {
     "STUDYID": "ABC-01",
     "DOMAIN": "DM",
     "USUBJID": "ABC-01-01-002",
     "SUBJID": "002",
     "RFSTDTC": "2024-03-04",
     "RFENDTC": "2024-03-31",
     "RFXSTDTC": "2024-03-04",
     "RFXENDTC": "2024-03-31",
     "RFICDTC": "2024-02-22",
     "RFPENDTC": "2024-03-31",
     "DTHDTC": "",
     "DTHFL": "",
     "SITEID": "01",
     "AGE": "60",
     "AGEU": "YEARS",
     "SEX": "M",
     "RACE": "ASIAN",
     "ETHNIC": "NOT HISPANIC OR LATINO",
     "ARMCD": "P",
     "ARM": "Placebo",
     "ACTARMCD": "P",
     "ACTARM": "Placebo",
     "COUNTRY": "JPN"
    }
   }
  },
  {
   "name": "AE",
   "class": "Events",
   "structure": "One record per adverse event per subject",
   "variables": [
    {
     "name": "STUDYID",
     "label": "Study Identifier",
     "type": "Char",
     "core": "Req",
     "origin": "Assigned",
     "srcData": "ae_raw",
     "srcVar": "STUDYID",
     "rule": "Constant \"ABC-01\"",
     "ct": "",
     "notes": ""
    },
    {
     "name": "DOMAIN",
     "label": "Domain Abbreviation",
     "type": "Char",
     "core": "Req",
     "origin": "Assigned",
     "srcData": "",
     "srcVar": "",
     "rule": "Literal \"AE\"",
     "ct": "",
     "notes": ""
    },
    {
     "name": "USUBJID",
     "label": "Unique Subject Identifier",
     "type": "Char",
     "core": "Req",
     "origin": "Derived",
     "srcData": "ae_raw",
     "srcVar": "SITEID, SUBJID",
     "rule": "See Global Rules",
     "ct": "",
     "notes": ""
    },
    {
     "name": "AESEQ",
     "label": "Sequence Number",
     "type": "Num",
     "core": "Req",
     "origin": "Derived",
     "srcData": "",
     "srcVar": "",
     "rule": "Sequential per subject, ordered by AESTDTC then AETERM",
     "ct": "",
     "notes": "See Global Rules"
    },
    {
     "name": "AETERM",
     "label": "Reported Term for the Adverse Event",
     "type": "Char",
     "core": "Req",
     "origin": "Collected",
     "srcData": "ae_raw",
     "srcVar": "AETERM",
     "rule": "VERBATIM, exactly as reported \u2014 never cleaned",
     "ct": "",
     "notes": "Topic variable"
    },
    {
     "name": "AEDECOD",
     "label": "Dictionary-Derived Term",
     "type": "Char",
     "core": "Req",
     "origin": "Derived",
     "srcData": "ae_raw",
     "srcVar": "AETERM",
     "rule": "Dictionary preferred term",
     "ct": "",
     "notes": "ILLUSTRATIVE \u2014 real coding needs licensed MedDRA"
    },
    {
     "name": "AESEV",
     "label": "Severity/Intensity",
     "type": "Char",
     "core": "Perm",
     "origin": "Collected",
     "srcData": "ae_raw",
     "srcVar": "AESEV",
     "rule": "Upper-case -> CT",
     "ct": "AESEV",
     "notes": "MILD / MODERATE / SEVERE"
    },
    {
     "name": "AESER",
     "label": "Serious Event",
     "type": "Char",
     "core": "Exp",
     "origin": "Collected",
     "srcData": "ae_raw",
     "srcVar": "AESER",
     "rule": "No/N -> N ; Yes -> Y",
     "ct": "NY",
     "notes": "Both 'No' and 'N' appear in raw"
    },
    {
     "name": "AEREL",
     "label": "Causality",
     "type": "Char",
     "core": "Exp",
     "origin": "Collected",
     "srcData": "ae_raw",
     "srcVar": "AEREL",
     "rule": "Upper-case source text",
     "ct": "",
     "notes": "Codelist commonly SPONSOR-DEFINED"
    },
    {
     "name": "AEOUT",
     "label": "Outcome of Adverse Event",
     "type": "Char",
     "core": "Perm",
     "origin": "Collected",
     "srcData": "ae_raw",
     "srcVar": "AEOUT",
     "rule": "Decode numeric code 1-5 to its CT term",
     "ct": "OUT",
     "notes": "Raw is a CRF dropdown CODE, not text \u2014 never pass the number through"
    },
    {
     "name": "AESTDTC",
     "label": "Start Date/Time of Adverse Event",
     "type": "Char",
     "core": "Exp",
     "origin": "Collected",
     "srcData": "ae_raw",
     "srcVar": "AESTDT",
     "rule": "Convert mixed formats to ISO 8601",
     "ct": "",
     "notes": "Two formats present"
    },
    {
     "name": "AEENDTC",
     "label": "End Date/Time of Adverse Event",
     "type": "Char",
     "core": "Perm",
     "origin": "Collected",
     "srcData": "ae_raw",
     "srcVar": "AEENDT",
     "rule": "Convert to ISO 8601",
     "ct": "",
     "notes": "BLANK = ONGOING \u2014 leave null"
    },
    {
     "name": "AESTDY",
     "label": "Study Day of Start of Event",
     "type": "Num",
     "core": "Perm",
     "origin": "Derived",
     "srcData": "",
     "srcVar": "",
     "rule": "See Global Rules (--DY)",
     "ct": "",
     "notes": ""
    },
    {
     "name": "AEENDY",
     "label": "Study Day of End of Event",
     "type": "Num",
     "core": "Perm",
     "origin": "Derived",
     "srcData": "",
     "srcVar": "",
     "rule": "See Global Rules (--DY)",
     "ct": "",
     "notes": "Null when the event is ongoing"
    }
   ],
   "example": {
    "usubjid": "ABC-01-01-002",
    "raw": {
     "STUDYID": "ABC-01",
     "SITEID": "01",
     "SUBJID": "002",
     "AETERM": "sore throat",
     "AESTDT": "28-Feb-2024",
     "AEENDT": "02-Mar-2024",
     "AESEV": "Mild",
     "AESER": "No",
     "AEREL": "Not related",
     "AEOUT": "1"
    },
    "sdtm": {
     "STUDYID": "ABC-01",
     "DOMAIN": "AE",
     "USUBJID": "ABC-01-01-002",
     "AESEQ": "1",
     "AETERM": "sore throat",
     "AEDECOD": "Oropharyngeal pain",
     "AESEV": "MILD",
     "AESER": "N",
     "AEREL": "NOT RELATED",
     "AEOUT": "RECOVERED/RESOLVED",
     "AESTDTC": "2024-02-28",
     "AEENDTC": "2024-03-02",
     "AESTDY": "-5",
     "AEENDY": "-2"
    }
   }
  },
  {
   "name": "SUPPAE",
   "class": "Relationship",
   "structure": "One record per supplemental qualifier",
   "variables": [
    {
     "name": "STUDYID",
     "label": "Study Identifier",
     "type": "Char",
     "core": "Req",
     "origin": "Assigned",
     "srcData": "",
     "srcVar": "",
     "rule": "Constant \"ABC-01\"",
     "ct": "",
     "notes": ""
    },
    {
     "name": "RDOMAIN",
